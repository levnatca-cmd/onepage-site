{
  "name": "systems-engineering-websites",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LEVNAT multi-page development website, Galaxy explorer and Starworld service map.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:studio": "node scripts/build-studio.mjs",
    "build:starworld": "node scripts/build-starworld.mjs",
    "build:pqc": "node scripts/build-pqc.mjs",
    "package:starworld": "node scripts/package-starworld.mjs",
    "test": "node tests/run.mjs",
    "test:galaxy": "node tests/verification/galaxy.mjs",
    "test:galaxy:browser": "node --test tests/functional/galaxy.mjs",
    "test:starworld": "node tests/verification/starworld.mjs",
    "test:content": "node tests/verification/content.mjs",
    "test:content:browser": "node tests/functional/content.mjs",
    "test:start": "node --test tests/unit/start.test.mjs",
    "test:studio": "node tests/verification/studio.mjs",
    "test:studio:browser": "node tests/functional/studio.mjs",
    "test:pqc": "node --test tests/unit/inquiries.test.mjs",
    "test:system": "node tests/unit/system-lab.mjs",
    "test:system:browser": "node tests/functional/system-lab.mjs",
    "qa:starworld": "node tests/support/prepare-starworld.mjs",
    "qa:uiux": "node tests/verification/uiux.mjs",
    "dev": "node scripts/serve.mjs",
    "dev:pqc": "node deploy/pqc/serve.mjs --local",
    "format": "prettier --write src/studio src/starworld scripts tests README.md docs .prettierrc.json package.json",
    "format:check": "prettier --check src/studio src/starworld scripts tests README.md docs .prettierrc.json package.json"
  },
  "devDependencies": {
    "lucide": "^1.69.0",
    "parse5": "^8.1.0",
    "prettier": "3.9.10"
  }
}
