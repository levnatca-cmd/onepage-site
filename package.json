{
  "name": "systems-engineering-websites",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LEVNAT multi-page development website, Galaxy explorer and Starworld service map.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:studio": "node scripts/build-studio.mjs",
    "build:starworld": "node scripts/build-starworld.mjs",
    "package:starworld": "node scripts/package-starworld.mjs",
    "test": "node scripts/check.mjs",
    "test:galaxy": "node tests/galaxy/scene-contract-check.mjs",
    "test:starworld": "node tests/starworld/check.mjs",
    "test:content": "node tests/content/check.mjs",
    "test:content:browser": "node tests/content/browser.mjs",
    "test:studio": "node tests/studio/check.mjs",
    "test:studio:browser": "node tests/studio/browser.mjs",
    "test:system": "node tests/system-lab/check.mjs",
    "test:system:browser": "node tests/system-lab/browser.mjs",
    "qa:starworld": "node scripts/prepare-starworld-qa.mjs",
    "qa:uiux": "node scripts/qa-uiux.mjs",
    "dev": "node scripts/serve.mjs",
    "format": "prettier --write src/studio src/starworld scripts tests README.md docs .prettierrc.json package.json",
    "format:check": "prettier --check src/studio src/starworld scripts tests README.md docs .prettierrc.json package.json"
  },
  "devDependencies": {
    "lucide": "^1.69.0",
    "parse5": "^8.1.0",
    "prettier": "3.9.10"
  }
}
